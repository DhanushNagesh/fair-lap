# `data/*`, not `data/`: git cannot re-include a file whose parent directory is
# excluded, so excluding the directory itself would make every `!` line below a
# no-op and the README would link to files that are not in the repo.
data/*
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.env
.DS_Store
dist/
build/
*.egg-info/

# The Phase 0 number must be reproducible, so the scan output is tracked.
!data/coverage.csv
!data/coverage_races.csv

# The Results section quotes these and embeds the plot, so they are tracked too.
!data/eval_*.csv
!data/eval_calibration.png

# The README's lead chart, from `make race-chart`.
!data/race_9947.png
!data/race_9947.gif

# The hosted dashboard reads this, from `make dashboard-db`.
!data/dashboard.duckdb

# Assistant instructions and local tool config stay on this machine.
CLAUDE.md
AGENTS.md
.claude/
